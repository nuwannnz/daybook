{
  "name": "api-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/application/src",
  "projectType": "library",
  "tags": ["scope:api", "type:application"],
  "// targets": "to see all targets run: nx show project api-application --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/api/application/tsconfig.lib.json",
          "tsc --noEmit -p libs/api/application/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
