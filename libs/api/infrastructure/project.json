{
  "name": "api-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:api", "type:infrastructure"],
  "// targets": "to see all targets run: nx show project api-infrastructure --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/api/infrastructure/tsconfig.lib.json",
          "tsc --noEmit -p libs/api/infrastructure/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config libs/api/infrastructure/vitest.integration.config.mts"
      }
    }
  }
}
