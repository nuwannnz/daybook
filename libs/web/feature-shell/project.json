{
  "name": "web-feature-shell",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/feature-shell/src",
  "projectType": "library",
  "tags": ["scope:web", "type:feature"],
  "// targets": "to see all targets run: nx show project web-feature-shell --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/web/feature-shell/tsconfig.lib.json",
          "tsc --noEmit -p libs/web/feature-shell/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
